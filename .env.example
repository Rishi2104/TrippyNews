# ── Optional: Gemini API key for LLM fallback (Phase 2+) ──
GEMINI_API_KEY=

# ── Optional: Telegram bot for error alerts (Phase 4) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Optional: Email alerts via SMTP (Phase 4) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# ── Pipeline overrides (all have defaults in settings.toml) ──
# NEWSCHECK_STORIES_PER_RUN=10
# NEWSCHECK_LLM_PROVIDER=ollama
